# ==============================================================================
# Revision RAG - Environment Configuration Example
# Copy this file to .env and adjust values for your setup.
# Never commit .env or secrets to version control.
# ==============================================================================

# ==============================================================================
# OPTION A: LOCAL-FIRST USER ENVIRONMENT (USER Mode - Default)
# ==============================================================================
# Students who clone this repository and run Revision RAG locally configure:
# 1. Their own Groq API key (for grounded answer generation).
# 2. Local persistent Qdrant (auto-loaded from data/qdrant - zero cloud/hosting cost).
#
# Note: Students do NOT need Docker, Qdrant Cloud, QDRANT_URL, QDRANT_API_KEY,
# or RETRIEVAL_API_URL.

APP_MODE=USER

# Groq Cloud API Key (Kept exclusively on your local computer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Local Qdrant Database (Pre-loaded with 7,000 vectors across both playlists)
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=revision_chunks

# Optional: Hosted Retrieval API URL (Only if using an external retrieval service)
# RETRIEVAL_API_URL=https://your-hosted-retrieval-api.com/api/v1/retrieve

# Local Server Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Persistent Storage & Database
DATA_DIR=./data
SQLITE_PATH=./data/revision_rag.db
ARTIFACTS_DIR=./data/artifacts
TEMP_AUDIO_DIR=./data/temp_audio
MODEL_CACHE_DIR=./data/models
DATABASE_URL=sqlite:///./data/revision_rag.db

# ==============================================================================
# OPTION B: HOSTED RETRIEVAL SERVER (Deployer Mode)
# ==============================================================================
# Configure these variables on your central server/cloud platform hosting the
# read-only retrieval service. Never distribute these credentials to end users.

# Qdrant Cloud Cluster Credentials
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_COLLECTION_NAME=revision_chunks
QDRANT_API_KEY=your_qdrant_api_key_here

# Embedding Model (Must match ingestion model: google/embeddinggemma-2)
EMBEDDING_MODEL_NAME=google/embeddinggemma-2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# Distributed Rate Limiting (Redis is optional; falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
MAX_QUERY_LENGTH=1000
MAX_TOP_K=10
MAX_CONCURRENT_REQUESTS=10

# Reverse Proxy & CORS (CORS is empty by default for server-to-server calls)
TRUSTED_PROXIES=127.0.0.1,::1
# CORS_ORIGINS=https://app.example.com

# ==============================================================================
# OPTION C: DEVELOPER PIPELINE (Admin Ingestion & Local Development)
# ==============================================================================
APP_MODE=DEVELOPER
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=revision_chunks
WHISPER_MODEL_NAME=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=300

TRANSLATION_SOURCE_LANG=hi
TRANSLATION_TARGET_LANG=en

WORKER_CONCURRENCY=1
WORKER_MAX_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_RETRY_DELAY_SECONDS=5

EXECUTION_DEVICE=cpu
