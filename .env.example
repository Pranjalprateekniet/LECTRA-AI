# ==============================================================================
# Revision RAG - Environment Configuration Example
# Copy this file to .env and adjust values for your local or container environment.
# Never commit .env or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server Settings (Host Binding)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend URL used by the Next.js frontend proxy (/api/* -> backend)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Persistent Storage & Paths
DATA_DIR=./data
SQLITE_PATH=./data/revision_rag.db
ARTIFACTS_DIR=./data/artifacts
TEMP_AUDIO_DIR=./data/temp_audio
MODEL_CACHE_DIR=./data/models

# Database Settings
DATABASE_URL=sqlite:///./data/revision_rag.db

# Vector Store (Qdrant Cloud)
# Note: Local Docker Qdrant is NOT used. Use your Qdrant Cloud cluster URL:
# Example: https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_COLLECTION_NAME=revision_chunks
QDRANT_API_KEY=your_qdrant_api_key_here

# Embedding Model (Sentence Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Speech Recognition (faster-whisper) — Phase 3.2
# Requires FFmpeg installed and available on system PATH (e.g. `sudo apt install ffmpeg`).
# WHISPER_MODEL_NAME: small.en (default), tiny.en, base.en, medium.en, large-v3
WHISPER_MODEL_NAME=small.en
# WHISPER_DEVICE: 'auto' (detects CUDA, falls back to CPU), 'cuda', or 'cpu'
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE: 'auto' (resolves to float16 on CUDA, int8 on CPU), or explicit:
# 'int8', 'float16', 'float32'
WHISPER_COMPUTE_TYPE=auto
# WHISPER_BEAM_SIZE: decoding beam width (default: 5)
WHISPER_BEAM_SIZE=5
WHISPER_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=300

# Translation (Argos Translate)
TRANSLATION_SOURCE_LANG=hi
TRANSLATION_TARGET_LANG=en

# LLM Provider Configuration (Groq Cloud API) — Phase 7
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Worker Settings
WORKER_CONCURRENCY=1
WORKER_MAX_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_RETRY_DELAY_SECONDS=5

# Hardware Acceleration
# Options: 'cpu' (default baseline) or 'cuda' (optional NVIDIA acceleration)
EXECUTION_DEVICE=cpu
