# ==============================================================================
# Revision RAG - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Students only need to provide their own GROQ_API_KEY below.
# All other settings are pre-configured for zero-hosting-cost, local-first operation.
# Never commit .env or secrets to version control.
# ==============================================================================

# ==============================================================================
# PROFILE 1: LOCAL-FIRST USER MODE (Default)
# ==============================================================================
# Queries the pre-indexed local persistent Qdrant database (7,000 chunks).
# Ingestion and mutation endpoints are disabled (HTTP 403) in USER mode.
# Docker, cloud accounts, and remote retrieval APIs are NOT required.

APP_MODE=USER

# Groq Cloud API Key (Kept exclusively on your local machine)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Local Persistent Qdrant Database (Embedded, runs directly in Python process)
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION_NAME=revision_chunks

# Server & Network Settings
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Persistent Storage Paths (Resolved relative to project root)
DATA_DIR=data
SQLITE_PATH=data/revision_rag.db
DATABASE_URL=sqlite:///./data/revision_rag.db
ARTIFACTS_DIR=data/artifacts
TEMP_AUDIO_DIR=data/temp_audio
MODEL_CACHE_DIR=data/models

# Hardware Acceleration
EXECUTION_DEVICE=cpu
EMBEDDING_DEVICE=cpu

# ==============================================================================
# OPTIONAL OVERRIDE: HOSTED RETRIEVAL API
# ==============================================================================
# If you prefer to query a central read-only hosted retrieval server instead of
# local Qdrant, uncomment and configure the endpoint below. When configured,
# USER mode routes query retrieval through this URL.
#
# RETRIEVAL_API_URL=https://your-retrieval-service.example.com/api/v1/retrieve
# RETRIEVAL_API_TIMEOUT_SECONDS=15.0

# ==============================================================================
# PROFILE 2: DEVELOPER & INGESTION MODE (Optional)
# ==============================================================================
# To ingest new YouTube playlists, transcribe audio with Whisper, translate
# transcripts, and index chunks into local Qdrant or Qdrant Cloud, change
# APP_MODE to DEVELOPER and uncomment the developer settings below:
#
# APP_MODE=DEVELOPER
#
# --- Qdrant Vector Database (Developer Mode) ---
# To use Qdrant Cloud instead of local Qdrant, set QDRANT_URL and QDRANT_API_KEY.
# If QDRANT_URL is left unset, DEVELOPER mode uses local Qdrant at QDRANT_PATH.
# QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
#
# --- Whisper Speech Recognition (Phase 3.2 ASR) ---
# WHISPER_MODEL_NAME=small.en
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto
# WHISPER_BEAM_SIZE=5
# WHISPER_AUDIO_DOWNLOAD_TIMEOUT_SECONDS=300
#
# --- Argos Translation (Hindi to English) ---
# TRANSLATION_SOURCE_LANG=hi
# TRANSLATION_TARGET_LANG=en
#
# --- Ingestion Worker Daemon ---
# WORKER_CONCURRENCY=1
# WORKER_MAX_RETRIES=3
# WORKER_POLL_INTERVAL_SECONDS=2
# WORKER_RETRY_DELAY_SECONDS=5
#
# --- Playlist Discovery & Captions ---
# DISCOVERY_SOCKET_TIMEOUT_SECONDS=30
# SUBTITLE_LANGUAGES=en
# SUBTITLE_PREFER_MANUAL=true

# ==============================================================================
# NOTE ON RELATED SERVICES
# ==============================================================================
# - Frontend Next.js: Configured in frontend/.env.example (NEXT_PUBLIC_API_URL).
# - Hosted Retrieval Service: Standalone deployment is configured in
#   retrieval_service/.env.example.
